{
    "name": "runtests",
    "displayName": "Runtests",
    "description": "Run a Julia package's Runtests test items from the Test Explorer",
    "version": "0.1.0",
    "publisher": "runtests",
    "license": "MIT",
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Testing"
    ],
    "main": "./src/extension.js",
    "activationEvents": [
        "workspaceContains:test/**/*_test.jl",
        "workspaceContains:test/**/*_tests.jl"
    ],
    "contributes": {
        "commands": [
            {
                "command": "runtests.runFailed",
                "title": "Run Failed Tests",
                "category": "Runtests",
                "icon": "$(run-errors)"
            },
            {
                "command": "runtests.restart",
                "title": "Restart Server",
                "category": "Runtests"
            },
            {
                "command": "runtests.showLog",
                "title": "Show Log",
                "category": "Runtests"
            }
        ],
        "configuration": {
            "title": "Runtests",
            "properties": {
                "runtests.julia.executable": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "The `julia` that runs the server. Empty: the Julia extension's `julia.executablePath`, or `julia` on the `PATH`."
                },
                "runtests.julia.args": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "markdownDescription": "Arguments given to `julia` first, such as `+1.12` to pick a juliaup channel."
                },
                "runtests.environment": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "The environment the server runs in, relative to the workspace folder; it must have Runtests. Empty: `test` when `test/Project.toml` exists, the folder itself otherwise."
                },
                "runtests.run.options": {
                    "type": "object",
                    "default": {},
                    "markdownDescription": "Settings sent with every run, such as `{\"workers\": 2}`: any of the `run` command's options in the editor protocol. Everything else comes from `test/TestItems.toml`."
                }
            }
        },
        "menus": {
            "view/title": [
                {
                    "command": "runtests.runFailed",
                    "when": "view == workbench.view.testing && runtests.active",
                    "group": "navigation"
                }
            ]
        }
    },
    "scripts": {
        "test": "node --test test/*.test.js"
    }
}
